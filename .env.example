# Copy to .env and fill in; never commit .env. Read by figure_vlm.py on the host (OPENROUTER_API_KEY) and by
# docker compose (env_file: every line below reaches the container). Defaults are those of service/config.py;
# a commented line keeps the default (an empty value is not the default: FIGURE_MODEL= turns figures off).

# OpenRouter key for figure descriptions, the identity check, embeddings and reranking. Sent only to OpenRouter, with
# zero-data-retention routing (providers that neither collect nor retain data, no fallbacks); never logged.
OPENROUTER_API_KEY=

# "1": never call OpenRouter; a stage that needs it is skipped with a warning (default: unset, calls allowed).
# OPENROUTER_OFFLINE=1

# Figure descriptions (vision model); an empty value turns them off.
# FIGURE_MODEL=openrouter:anthropic/claude-opus-5.5
# Identity check: a model picks the titles, sponsor, ids and version from the first three pages and the running
# headers/footers (one request per document, cached); the code keeps only values it finds in the cited lines.
# Default: the model below; an empty value turns the check off (the rules only).
# IDENTITY_MODEL=openrouter:anthropic/claude-opus-5.5
# Chunk and query embeddings.
# EMBED_MODEL=qwen/qwen3-embedding-8b
# Search reranker.
# RERANK_MODEL=qwen/qwen3-reranker-8b

# Documents processed at the same time (each job is one child process: about 5 GiB at peak for a 150-page
# protocol, so raise mem_limit in docker-compose.yml with it).
# WORKER_CONCURRENCY=1
# Figure-description requests in flight per document.
# FIGURE_CONCURRENCY=4
# Largest accepted PDF, in MB.
# MAX_UPLOAD_MB=100
# DEBUG, INFO, WARNING, ERROR.
# LOG_LEVEL=INFO

# Host names clients may address the service by, comma-separated ("*" turns the check off). Default:
# localhost,127.0.0.1,::1. Behind a domain, add its name and keep 127.0.0.1: the container healthcheck
# calls http://127.0.0.1:8000/health.
# ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Set by the image and by docker-compose.yml (which overrides .env); only for running on the host:
# DATA_DIR=./data            (container: /data, the protocol-data volume; host default: ./data next to the code)
# HOST=127.0.0.1             (container: 0.0.0.0, published on 127.0.0.1:8000 only)
# PORT=8000
