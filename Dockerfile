# Protocol ingestion service: REST API + MCP + background worker in one container (one process per DATA_DIR).
#
#   python scripts/check_build_context.py                     # host-side context check, before every build
#   docker build -t protocol-service .                        # production image (the last stage)
#   docker build --target test -t protocol-service:test .     # + the offline service self-tests
#   docker compose up -d                                      # see docker-compose.yml
#
# The build context is a whitelist (.dockerignore, generated by `python -m service.runtime --write-dockerignore`):
# no PDF, output, report, cache, .env or local_config.json can reach it, and the context-check stage fails the
# build if one does. Models are fetched at build time and verified offline as the runtime user; the container
# never downloads anything (HF_HUB_OFFLINE=1). Base images are pinned by tag: before hosting, pin them by digest
# (FROM python:3.13.6-slim-bookworm@sha256:...) and add hashes to requirements.lock.

ARG PYTHON_IMAGE=python:3.13.6-slim-bookworm
ARG NODE_IMAGE=node:22.18.0-bookworm-slim
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# System libraries Python packages load at import time: opencv-python (rapidocr requires the non-headless build)
# links libGL, libxcb, libSM / libICE and GLib. Needed wherever cv2 is imported: the models and runtime stages
# (the models stage lists any library still missing).
ARG RUNTIME_PACKAGES="libgl1 libglib2.0-0 libxcb1 libsm6 libice6"

# ---------------------------------------------------------------------------------------------------------------
# context-check: the only stage that sees the whole context. It fails on any PDF or forbidden path, then copies
# out exactly service.runtime.runtime_files() (/app) and the test target's files (/app-tests); later stages take
# only those, so nothing else in the context can reach an image, and every image depends on this check.
FROM ${PYTHON_IMAGE} AS context-check
COPY . /ctx
# (CRs stripped: a Windows checkout with core.autocrlf=true gives the script CRLF line ends)
RUN sed 's/\r$//' /ctx/docker/check_context.sh | sh -s /ctx \
 && python /ctx/service/runtime.py --copy-to /app \
 && python /ctx/service/runtime.py --copy-tests-to /app-tests \
 && python -m compileall -q --invalidation-mode checked-hash /app /app-tests

# ---------------------------------------------------------------------------------------------------------------
# python-deps: the virtual environment (build tools only here, for any package that ships as an sdist).
FROM ${PYTHON_IMAGE} AS python-deps
ARG TORCH_INDEX_URL
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential \
 && rm -rf /var/lib/apt/lists/*
ENV PATH=/opt/venv/bin:$PATH \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore
RUN python -m venv /opt/venv
COPY requirements.lock /build/requirements.lock
COPY docker/lock_report.py /build/docker/lock_report.py
# 1. torch + torchvision (pins from the lock) from the PyTorch CPU index only, without dependencies: no CUDA
#    build can be chosen and no other package comes from that index;
# 2. everything else from PyPI, with torch / torchvision held at the CPU build just installed (PyPI has no
#    "+cpu" version, so a resolver wanting another torch fails instead of pulling CUDA wheels);
# 3. refuse CUDA packages or a CUDA-enabled torch, check consistency, and report what pip added beyond the
#    lock (packages only Linux needs: fold them in with docker/lock_report.py).
RUN --mount=type=cache,target=/root/.cache/pip \
    set -eu; \
    grep -E '^(torch|torchvision)==' /build/requirements.lock > /build/torch.txt; \
    pip install --no-deps --index-url "$TORCH_INDEX_URL" -r /build/torch.txt; \
    pip freeze | grep -E '^(torch|torchvision)==' > /build/torch-constraints.txt; \
    pip install -r /build/requirements.lock -c /build/torch-constraints.txt; \
    if pip freeze | grep -Eiq '^(nvidia-|triton|cuda-)'; then echo "CUDA packages were installed" >&2; exit 1; fi; \
    python -c "import sys, torch; sys.exit('torch has CUDA ' + torch.version.cuda if torch.version.cuda else 0)"; \
    pip check; \
    python /build/docker/lock_report.py

# ---------------------------------------------------------------------------------------------------------------
# models: Docling layout / TableFormer / picture classifier and the Qwen3 tokenizer into /opt/models (Hugging Face
# cache layout), RapidOCR's torch models into rapidocr's own folder in the venv (docker/fetch_models.py says what
# and why). No application code here, so code changes keep this layer cached.
FROM python-deps AS models
ARG RUNTIME_PACKAGES
RUN apt-get update \
 && apt-get install -y --no-install-recommends ${RUNTIME_PACKAGES} \
 && rm -rf /var/lib/apt/lists/*
# Every shared library OpenCV's extension and bundled libraries link must resolve: one failure listing all that
# are missing, instead of one ImportError per build attempt.
RUN missing=$(find /opt/venv/lib \( -path '*cv2*' -o -path '*opencv*' \) -name '*.so*' -type f \
        | xargs -r ldd 2>/dev/null | grep 'not found' | sort -u); \
    if [ -n "$missing" ]; then echo "system libraries missing for OpenCV (add to RUNTIME_PACKAGES):" >&2; \
        echo "$missing" >&2; exit 1; fi
ENV HF_HOME=/opt/models \
    HF_HUB_DISABLE_TELEMETRY=1
COPY docker/fetch_models.py /build/docker/fetch_models.py
RUN python /build/docker/fetch_models.py --download
RUN --network=none python /build/docker/fetch_models.py --verify

# ---------------------------------------------------------------------------------------------------------------
# node-deps: the Mermaid validator's packages (pure JavaScript, no install scripts) from the committed lockfile.
FROM ${NODE_IMAGE} AS node-deps
WORKDIR /build
COPY tools/mermaid_validate/package.json tools/mermaid_validate/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund

# ---------------------------------------------------------------------------------------------------------------
# runtime: what the service needs and nothing else.
#   RUNTIME_PACKAGES  opencv-python (required by rapidocr) loads libGL, libxcb, libSM / libICE and GLib on import
#   tini              PID 1: forwards SIGTERM to the server only (a running job's child process finishes
#                     during the worker's 30 s stop) and reaps the pipeline's orphaned subprocesses
#   node              the official Node 22 binary of the same Debian release (tools/mermaid_validate)
FROM ${PYTHON_IMAGE} AS runtime
ARG RUNTIME_PACKAGES
RUN apt-get update \
 && apt-get install -y --no-install-recommends ${RUNTIME_PACKAGES} tini \
 && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 10001 app \
 && useradd --uid 10001 --gid 10001 --home-dir /home/app --create-home --shell /usr/sbin/nologin app \
 && install -d -o 10001 -g 10001 -m 0750 /data
COPY --from=node-deps /usr/local/bin/node /usr/local/bin/node
COPY --from=models /opt/venv /opt/venv
COPY --from=models /opt/models /opt/models
COPY --from=node-deps /build/node_modules /app/tools/mermaid_validate/node_modules
COPY --from=context-check /app /app
# OPENROUTER_OFFLINE stays unset: figure descriptions, embeddings and reranking need the key from the
# environment (docker-compose.yml: env_file .env). Writes go to /data only (a named volume in compose; the
# image's /data, owned by the runtime user, initialises it).
ENV PATH=/opt/venv/bin:$PATH \
    VIRTUAL_ENV=/opt/venv \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/opt/models \
    HF_HUB_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    DATA_DIR=/data \
    HOST=0.0.0.0 \
    PORT=8000 \
    HOME=/home/app
WORKDIR /app
USER 10001:10001
EXPOSE 8000
# /health answers 200 when the registry and the worker are healthy, else 503: urlopen raises (exit 1), as it does
# when nothing listens. Python's urllib: the slim image has no curl.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 CMD ["python", "-c", \
    "import os, urllib.request as u; u.urlopen('http://127.0.0.1:%s/health' % os.getenv('PORT', '8000'), timeout=4)"]
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "-m", "service.api"]

# ---------------------------------------------------------------------------------------------------------------
# verify: every model and import loads through the service's own code, as the runtime user, with no network.
# The images below copy its marker, so an incomplete or unreadable model set fails the build.
FROM runtime AS verify
COPY docker/fetch_models.py /tmp/fetch_models.py
RUN --network=none python /tmp/fetch_models.py --verify --app /app \
 && touch /tmp/models-verified

# ---------------------------------------------------------------------------------------------------------------
# test: the production image plus the offline service self-tests (`docker build --target test`), e.g.
#   docker run --rm protocol-service:test python tests/test_service_api.py
FROM runtime AS test
COPY --from=verify /tmp/models-verified /opt/models/.verified
COPY --from=context-check /app-tests/ /app/
ENV OPENROUTER_OFFLINE=1
CMD ["sh", "-c", "for t in tests/test_service_*.py; do echo \"== $t\"; python \"$t\" || exit 1; done"]

# ---------------------------------------------------------------------------------------------------------------
# production (default target): the runtime image, built only once the verify stage passed.
FROM runtime AS production
COPY --from=verify /tmp/models-verified /opt/models/.verified
